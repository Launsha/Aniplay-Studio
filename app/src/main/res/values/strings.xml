    <!-- Ucapan Selamat Datang & Panduan (Onboarding / Guide) -->
    <string name="greeting_morning">Selamat Pagi! ☀️</string>
    <string name="greeting_afternoon">Selamat Siang! 🌤️</string>
    <string name="greeting_evening">Selamat Sore! 🌅</string>
    <string name="greeting_night">Selamat Malam! 🌙</string>
    <string name="greeting_welcome_subtitle">Selamat datang kembali di AnimePlay. Bioskop anime offline pribadimu siap diputar kapan saja.</string>

    <string name="onboarding_page1_title">Selamat Datang di AnimePlay!</string>
    <string name="onboarding_page1_body">Nikmati tontonan anime lokal bergaya bioskop gelap dengan aksen oranye VLC, lengkap dengan pemindaian folder pilihan, pelacakan MyAnimeList, dan kontrol gestur profesional.</string>
    <string name="onboarding_page2_title">Halaman Rapi &amp; Pustaka Pintar</string>
    <string name="onboarding_page2_body">Aplikasimu dibagi menjadi 4 halaman utama: Beranda untuk lanjut menonton, Pustaka untuk cari &amp; sortir koleksi, Statistik untuk grafik mingguan, dan Pengaturan lanjutan ala VLC.</string>
    <string name="onboarding_page3_title">Kontrol Pemutar Ala VLC Mobile</string>
    <string name="onboarding_page3_body">Geser kiri untuk kecerahan, geser kanan untuk volume, ketuk dua kali untuk lompat cepat, atur Equalizer audio, pilih multi-track audio MKV, ganti rasio layar, hingga Skip OP +85 dtk!</string>
    <string name="onboarding_page4_title">Siap Memulai Petualangan?</string>
    <string name="onboarding_page4_body">Pilih folder tempat kamu menyimpan file video anime (.mkv, .mp4, .avi, .webm), atau langsung jelajahi aplikasi dan atur kapan saja di menu Pengaturan.</string>
    <string name="onboarding_pick_folder_cta">Pilih Folder Anime Sekarang</string>

    <string name="guide_screen_title">Panduan &amp; Tips AnimePlay</string>
    <string name="guide_naming_title">Format Penamaan File Otomatis</string>
    <string name="guide_naming_body">AnimePlay otomatis mengenali judul dan nomor episode dari pola seperti “[SubsGroup] Sousou no Frieren - 05 [1080p].mkv”. Jika gagal, nama folder induk akan dipakai sebagai judul seri.</string>
    <string name="guide_gestures_title">Gestur &amp; Pintasan Pemutar VLC</string>
    <string name="guide_gesture_left">Geser Vertikal Kiri: Atur Kecerahan Layar</string>
    <string name="guide_gesture_right">Geser Vertikal Kanan: Atur Volume Media</string>
    <string name="guide_gesture_double">Ketuk Dua Kali Kiri/Kanan: Mundur/Maju Cepat</string>
    <string name="guide_gesture_lock">Ikon Gembok: Kunci Sentuhan agar tidak tersentuh tak sengaja</string>
    <string name="guide_mal_title">Integrasi &amp; Ekspor MyAnimeList</string>
    <string name="guide_mal_body">Hubungkan anime di halaman Detail untuk mengisi sinopsis, cover, genre, skor MAL otomatis, serta ekspor daftar tontonan ke format XML standar MyAnimeList dari Pengaturan.</string>
    <string name="guide_replay_welcome">Putar Ulang Sambutan Awal</string>

