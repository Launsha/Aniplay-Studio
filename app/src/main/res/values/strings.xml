    <string name="guide_naming_title">Penamaan file otomatis</string>
    <string name="guide_naming_body">AnimePlay membaca judul dan nomor episode dari pola seperti "[Kelompok] Judul Anime - 05 [1080p].mkv". Jika pola tidak dikenali, nama folder induk dipakai sebagai judul seri.</string>
